{
  "name": "octarine-client",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": "github:pan-narrans/octarine",
  "type": "module",
  "engines": {
    "node": ">=26.3.1 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run src",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "visual:test": "playwright test",
    "visual:update": "playwright test --update-snapshots",
    "test:updater-manifests": "node --test .github/scripts/update-manifests.test.mjs",
    "test:canonical-updater-manifest": "node --test .github/scripts/canonicalize-updater-manifest.test.mjs",
    "test:release-config": "node --test .github/scripts/release-config.test.mjs",
    "test:release-smoke": "node --test .github/scripts/validate-smoke-report.test.mjs",
    "test:public-release": "node --test .github/scripts/verify-public-release.test.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs --write",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "ipc:generate": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings -- --ignored && prettier --write src/generated/ipc",
    "ipc:check": "npm run ipc:generate && git diff --exit-code -- src/generated/ipc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@storybook/react-vite": "^10.6.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "storybook": "^10.5.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
